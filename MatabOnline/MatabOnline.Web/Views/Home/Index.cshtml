@model HomeViewModel
@{
    ViewData["Title"] = "رزرو نوبت";
}

<section id="doctors" class="section">
    <h2>👨‍⚕️ پزشکان</h2>
    <div class="doctor-grid">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="card doctor-card">
                <h3>@doctor.FullName</h3>
                <p>@doctor.Specialty</p>
                <p>@doctor.Info</p>
                <p>📞 @doctor.ClinicPhoneNumber</p>
            </div>
        }
    </div>
</section>

<section id="appointment" class="section">
    <h2>📅 درخواست نوبت</h2>

    @if (TempData["AppointmentSuccess"] is string success)
    {
        <p class="alert alert-success">@success</p>
    }
    @if (TempData["AppointmentError"] is string error)
    {
        <p class="alert alert-error">@error</p>
    }

    <div class="card form-card">
        <form asp-controller="Home" asp-action="BookAppointment" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="AppointmentForm.DoctorId">نام پزشک</label>
            <select asp-for="AppointmentForm.DoctorId" required>
                <option value="">-- انتخاب کنید --</option>
                @foreach (var doctor in Model.Doctors)
                {
                    <option value="@doctor.Id">@doctor.FullName - @doctor.Specialty</option>
                }
            </select>
            <span asp-validation-for="AppointmentForm.DoctorId" class="text-danger"></span>

            <label asp-for="AppointmentForm.PatientName">نام بیمار</label>
            <input asp-for="AppointmentForm.PatientName" placeholder="نام و نام خانوادگی" required />
            <span asp-validation-for="AppointmentForm.PatientName" class="text-danger"></span>

            <label asp-for="AppointmentForm.PatientPhoneNumber">شماره تماس</label>
            <input asp-for="AppointmentForm.PatientPhoneNumber" placeholder="0912..." required />
            <span asp-validation-for="AppointmentForm.PatientPhoneNumber" class="text-danger"></span>

            <label asp-for="AppointmentForm.AppointmentDate">تاریخ مورد نظر</label>
            <input asp-for="AppointmentForm.AppointmentDate" type="date" required />
            <span asp-validation-for="AppointmentForm.AppointmentDate" class="text-danger"></span>

            <button type="submit" class="btn">ثبت درخواست نوبت</button>
        </form>
    </div>
</section>

<section id="contact" class="section">
    <h2>✉️ تماس با ما</h2>

    @if (TempData["ContactSuccess"] is string contactSuccess)
    {
        <p class="alert alert-success">@contactSuccess</p>
    }
    @if (TempData["ContactError"] is string contactError)
    {
        <p class="alert alert-error">@contactError</p>
    }

    <div class="card form-card">
        <form asp-controller="Home" asp-action="SendContactMessage" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="ContactForm.FullName">نام</label>
            <input asp-for="ContactForm.FullName" required />
            <span asp-validation-for="ContactForm.FullName" class="text-danger"></span>

            <label asp-for="ContactForm.Email">ایمیل</label>
            <input asp-for="ContactForm.Email" required />
            <span asp-validation-for="ContactForm.Email" class="text-danger"></span>

            <label asp-for="ContactForm.Message">پیام</label>
            <textarea asp-for="ContactForm.Message" required></textarea>
            <span asp-validation-for="ContactForm.Message" class="text-danger"></span>

            <button type="submit" class="btn">ارسال پیام</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}