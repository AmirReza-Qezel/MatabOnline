@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "پنل مدیریت";
    var doctors = (IReadOnlyList<DoctorDto>)ViewBag.Doctors;
    var users = (IReadOnlyList<AdminUserDto>)ViewBag.Users;
    var canManage = (await AuthorizationService.AuthorizeAsync(User, Permissions.ManageDoctors)).Succeeded;
    var canEditDoctor = (await AuthorizationService.AuthorizeAsync(User, Permissions.EditDoctor)).Succeeded;
}

<main class="container admin-page">
    <section class="admin-header">
        <div>
            <h1>پنل مدیریت</h1>
            <p>مدیریت کاربران، دسترسی‌ها و اطلاعات پزشکان</p>
        </div>
        <div class="admin-badge">👨‍💼 مدیر سیستم</div>
    </section>

    @if (canManage)
    {
        <section class="admin-section">
            <div class="section-title">
                <div class="section-icon">👤</div>
                <div>
                    <h2>افزودن کاربر جدید</h2>
                    <p>یک کاربر جدید به سیستم اضافه کنید.</p>
                </div>
            </div>

            @if (TempData["UserSuccess"] is string userSuccess)
            {
                <p class="alert alert-success">@userSuccess</p>
            }
            @if (TempData["UserError"] is string userError)
            {
                <p class="alert alert-error">@userError</p>
            }

            <div class="card admin-card">
                <form asp-controller="Admin" asp-action="CreateUser" method="post">
                    <div class="form-row">
                        <div class="form-group">
                            <label>نام</label>
                            <input type="text" name="FirstName" required />
                        </div>
                        <div class="form-group">
                            <label>نام خانوادگی</label>
                            <input type="text" name="LastName" required />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>کد ملی</label>
                            <input type="text" name="NCode" required />
                        </div>
                        <div class="form-group">
                            <label>ایمیل کاربر</label>
                            <input type="email" name="Email" placeholder="example@email.com" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>رمز عبور</label>
                        <input type="password" name="Password" required />
                    </div>
                    <button type="submit" class="btn">+ ایجاد کاربر</button>
                </form>
            </div>
        </section>

        <section class="admin-section">
            <div class="section-title">
                <div class="section-icon">🔐</div>
                <div>
                    <h2>کاربران و دسترسی‌ها</h2>
                    <p>مدیریت کاربران و Claimهای هر کاربر</p>
                </div>
            </div>

            @foreach (var user in users)
            {
                <div class="user-row card">
                    <h3>@user.FirstName @user.LastName</h3>
                    <p>@user.Email</p>
                    @{
                        var claims = await Component.InvokeAsync("UserClaims", new { userId = user.Id });
                    }
                    @claims
                </div>
            }
        </section>
    }

    <section class="admin-section">
        <div class="section-title">
            <div class="section-icon">👨‍⚕️</div>
            <div>
                <h2>مدیریت پزشکان</h2>
                <p>مشاهده و مدیریت اطلاعات پزشکان سیستم</p>
            </div>
        </div>

        @if (canEditDoctor)
        {
            <div class="card admin-card">
                <form asp-controller="Admin" asp-action="CreateDoctor" method="post">
                    <div class="form-row">
                        <div class="form-group">
                            <label>نام پزشک</label>
                            <input type="text" name="FullName" required />
                        </div>
                        <div class="form-group">
                            <label>تخصص</label>
                            <input type="text" name="Specialty" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>توضیحات</label>
                        <textarea name="Info"></textarea>
                    </div>
                    <div class="form-group">
                        <label>شماره تماس مطب</label>
                        <input type="tel" name="ClinicPhoneNumber" required />
                    </div>
                    <button type="submit" class="btn">+ افزودن پزشک</button>
                </form>
            </div>
        }

        @foreach (var doctor in doctors)
        {
            <div class="admin-doctor-row card">
                <div>
                    <h3>دکتر @doctor.FullName</h3>
                    <p>@doctor.Specialty</p>
                </div>
                @if (canManage)
                {
                    <form asp-controller="Admin" asp-action="DeleteDoctor" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@doctor.Id" />
                        <button type="submit" class="btn btn-danger">حذف</button>
                    </form>
                }
            </div>
        }
    </section>
</main>
